{
  // Подсказки и проверка типов в VS Code для кода без сборки (JS + JSDoc).
  // Проверяются файлы с // @ts-check в начале; остальные только подсказывают.
  // three.js подключается через importmap, поэтому его типы — заглушка types/three.d.ts (имена есть, всё any).
  // Полные типы: npm i -D @types/three@0.160 и удалите types/three.d.ts.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "checkJs": false,
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "useUnknownInCatchVariables": false
  },
  "include": ["public/engine/**/*.js", "public/engine/**/*.d.ts", "public/assets/**/*.js", "tools/**/*.js", "types/**/*.d.ts"],
  "exclude": ["public/vendor/**", "server/**"]
}
