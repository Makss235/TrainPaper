// Составы и правила выбора состава для поезда с табло РЖД.
//
// types — составы: consist — вагоны от ГОЛОВЫ к хвосту: имена моделей из assets/models/ или префабов "cars/…".
//   "trains/emu-head:flip"                          — вагон развёрнут
//   { "model": "trains/coach-fpk", "repeat": 6 }    — несколько одинаковых подряд
//   { "random": ["trains/boxcar", "trains/tank"], "count": [18, 32], "groups": 0.22 }
//                                                   — случайная смесь (groups — как часто меняется вид вагона)
// rules — какой состав показать: первое подходящее правило. Поля правила (кроме use и note) — регулярные
//   выражения по полям поезда из табло: number ("119А"), from, to, type (long | suburban | other), kind
//   (arrival | departure | transit). default — если ни одно не подошло.
// Сцена может добавить свои правила: компонент RzdBoard, свойство rules.
{
  "types": {
    "fpk-long": {
      "name": "Пассажирский дальнего следования",
      "consist": ["trains/loco-ep", { "model": "trains/coach-fpk", "repeat": 6 }]
    },
    "fpk-double": {
      "name": "Двухэтажный",
      "consist": ["trains/loco-ep", { "model": "trains/coach-double", "repeat": 6 }]
    },
    "emu-fast": {
      "name": "Скоростной электропоезд",
      "consist": ["trains/emu-head", { "model": "trains/emu-middle", "repeat": 3 }, "trains/emu-head:flip"]
    },
    "freight": {
      "name": "Грузовой",
      "consist": [
        "trains/loco-freight", "trains/loco-freight:flip",
        { "random": ["trains/boxcar", "trains/tank", "trains/gondola"], "count": [18, 32], "groups": 0.22 }
      ]
    }
  },

  "rules": [
    // двухэтажные — пример по памяти (5/6, 23/24, 103/104): сверьте с актуальным расписанием
    { "number": "^(00[56]|02[34]|10[34])\\D", "use": "fpk-double" },
    // 7xx — скоростные дневные, 8xx — скоростные пригородные
    { "number": "^[78]\\d\\d", "use": "emu-fast" },
    { "type": "^suburban$", "use": "emu-fast" }
  ],

  "default": "fpk-long"
}
