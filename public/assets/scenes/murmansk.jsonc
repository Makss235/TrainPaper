// Мурманск — северный тупиковый вокзал. Блокаут: сопки на горизонте, редкий низкорослый лес,
// платформа с коротким навесом у здания вокзала, три пути. Камера чуть выше обычного.
// Платформа короткая, 120 м: её конец виден; дальше к сопкам уходят только пути и сеть.
// Здание вокзала — заготовка; свою модель поставьте вместо объекта «Вокзал».
{
  "name": "Мурманск",
  "environment": {
    "azimuth": 170,                                  // пути уходят на юг вдоль Кольского залива
    "weather": "partly",
    "planes": true,                                   // изредка высоко пролетает самолёт со шлейфом
    "shadows": { "x": [-22, 20], "y": [-1, 12], "z": [16, -110] }
  },
  "objects": [
    { "name": "Основной", "position": [-0.4, 3.0, 2], "rotation": [-0.4, -1.5, 0],
      "components": [{ "type": "Camera", "main": true, "label": "Основной", "focal": [0.56, 0.98], "center": [0.42, 0.46] }, { "type": "CameraParallax" }] },
    { "name": "Общий", "position": [-3.5, 4.3, 12],
      "components": [{ "type": "Camera", "label": "Общий", "target": [4, 2.5, -70], "focal": [0.46, 0.8], "center": [0.45, 0.48] }, { "type": "CameraParallax" }] },

    { "name": "Земля", "position": [0, -0.32, 0], "components": [{ "type": "Model", "model": "environment/ground", "params": { "color": "#7f8a74" }, "castShadow": false }] },
    { "name": "Сопки", "components": [{ "type": "Model", "model": "environment/hills", "castShadow": false, "params": { "seed": 11, "width": 11000, "ridges": [
      { "z": -1400, "height": [40, 140], "color": "#6f7d72", "haze": 0.55, "count": 11 },
      { "z": -2600, "height": [110, 300], "color": "hills", "haze": 0.6, "count": 9 },
      { "z": -4200, "height": [220, 480], "color": "hills2", "haze": 0.55, "count": 7 } ] } }] },
    { "name": "Лес слева", "position": [-16, -0.32, -40], "repeat": { "count": 66, "step": [0, 0, -7], "jitter": [4, 0, 2], "scaleJitter": 0.3, "seed": 29 },
      "components": [{ "type": "Model", "model": "environment/tree", "params": { "trunk": 2.6, "crown": 2.2, "color": "#4b6650", "lumps": 2 } }] },
    { "name": "Лес справа", "position": [24, -0.32, -30], "repeat": { "count": 61, "step": [0, 0, -8], "jitter": [5, 0, 2], "scaleJitter": 0.3, "seed": 31 },
      "components": [{ "type": "Model", "model": "environment/tree", "params": { "trunk": 2.6, "crown": 2.0, "color": "#56705a", "lumps": 2, "seed": 4 } }] },

    { "name": "Путь 1", "position": [4.42, 0, 0], "components": [{ "type": "Model", "model": "station/track" }, { "type": "Track", "points": [[0, 0, 300], [0, 0, -3000]], "visible": [270, 800] }] },
    { "name": "Путь 2", "position": [9.6, 0, 0], "components": [{ "type": "Model", "model": "station/track" }, { "type": "Track", "points": [[0, 0, 300], [0, 0, -3000]], "visible": [270, 800] }] },
    { "name": "Путь 3", "position": [14.8, 0, 0], "components": [{ "type": "Model", "model": "station/track" }, { "type": "Track", "points": [[0, 0, 300], [0, 0, -3000]], "visible": [270, 800] }] },
    { "name": "Сеть путей 2–3", "position": [12.2, 0, -26], "components": [{ "type": "Model", "model": "station/catenary", "params": { "tracks": [-2.6, 2.6], "span": 55, "count": 14, "height": 9.8 } }] },
    { "name": "Сеть пути 1", "position": [7.0, 0, -26], "components": [{ "type": "Model", "model": "station/catenary", "params": { "tracks": [-2.58], "span": 55, "count": 14, "height": 9.8 } }] },

    { "name": "Платформа", "position": [-1.35, 0, 20],
      "components": [{ "type": "Model", "model": "station/platform", "params": { "length": 120, "width": 7.7 }, "castShadow": false }] },
    { "name": "Навес", "position": [-1.55, 1.1, 18],
      "components": [{ "type": "Model", "model": "station/canopy", "params": { "width": 6.7, "length": 64, "height": 3.9, "thickness": 0.26, "columns": [-2.35], "step": 8, "offset": 4 } }] },
    { "name": "Светильник навеса", "prefab": "canopy-lamp", "position": [-1.2, 5.0, 12], "repeat": { "count": 7, "step": [0, 0, -8] } },
    { "name": "Фонарь", "prefab": "lamp", "position": [-4.6, 1.1, -52], "repeat": { "count": 3, "step": [0, 0, -22] },
      "components": [
        { "type": "Model", "params": { "height": 4.8, "arm": 0.9 } },
        { "type": "Light", "offset": [1.0, 4.3, 0] },
        { "type": "Glow", "offset": [1.0, 4.58, 0] }] },
    { "name": "Табло", "prefab": "departure-board", "position": [-1.55, 1.1, -8.5],
      "components": [{ "type": "Model", "params": { "width": 2.7, "height": 0.9, "bottom": 2.0 } },
                     { "type": "HtmlScreen", "size": [2.58, 0.78], "offset": [0, 2.45, 0.002] }] },
    { "name": "Ограда", "prefab": "fence", "position": [-5.2, 1.1, -46],
      "components": [{ "type": "Model", "params": { "length": 54, "height": 1.0 } }, { "type": "StripeShadow", "length": 54, "top": 1.0, "crossbars": [1.0, 0.12] }] },

    { "name": "Вокзал", "position": [-24.25, -0.32, -8],
      "components": [{ "type": "Model", "model": "station/building", "params": { "size": [31.5, 13.8, 64], "color": "#9fc3b4",
        "windows": { "rows": 2, "step": 5.2, "bottom": 3.2, "width": 1.9, "height": 3.0, "gap": 2.6, "color": "#3f4c55" } } }] },
    { "name": "Башня вокзала", "position": [-19, 13.5, -4],
      "components": [{ "type": "Primitive", "size": [10, 7.5, 12], "pivot": "bottom", "color": "#9fc3b4" },
                     { "type": "Primitive", "size": [10.5, 0.5, 12.5], "offset": [0, 7.5, 0], "color": "trim" }] },
    { "name": "Склады", "position": [43, -0.3, -155], "rotation": [0, 180, 0],
      "components": [{ "type": "Model", "model": "station/building", "params": { "size": [34, 9.3, 70], "color": "wallDark", "gable": 3,
        "windows": { "rows": 1, "bottom": 3, "width": 3.2, "height": 2.4, "gap": 6 } } }] },

    // тупиковый вокзал: прибывший стоит хвостом в 8 м от камеры, отправляющийся — хвостом у z = 22 к горизонту
    { "name": "Платформа 1", "position": [4.42, 0, -8],
      "components": [{ "type": "StopPoint", "track": "Путь 1", "align": "tail", "platform": { "top": 1.1, "edge": 1.92, "side": "left" } }] },
    { "name": "Отправление", "position": [4.42, 0, 22],
      "components": [{ "type": "StopPoint", "track": "Путь 1", "align": "tail", "platform": { "top": 1.1, "edge": 1.92, "side": "left" } }] },
    { "name": "Движение", "components": [
      { "type": "TrainManager", "pause": 2.4 },
      { "type": "Schedule" },
      { "type": "RzdBoard", "track": "Путь 1", "motion": { "brake": 1.2, "accel": 0.6 },
        "arrival": { "stop": "Платформа 1", "direction": -1, "approach": 440 },
        "departure": { "stop": "Отправление", "direction": 1 } },
      // грузовые по соседним путям раз в 5–14 минут, в обе стороны; не нужны — удалите эту строку
      { "type": "rail/random-traffic", "consists": ["freight"], "tracks": ["Путь 2", "Путь 3"], "direction": 0, "every": [300, 840], "speed": [12, 16], "first": 45 }
    ] }
  ]
}
