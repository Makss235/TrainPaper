// «Типовая платформа» — сцена по умолчанию для станций без своей сцены.
// Стоим на платформе и смотрим вдоль пути: справа — хвост поезда, путь уходит к горизонту,
// контактная сеть, ограда, фонари, деревья, город у горизонта; над платформой — табло.
//
// Координаты — метры: x — поперёк пути (вправо), y — вверх от головки рельса, z — вдоль пути;
// камера у z = 0 смотрит в сторону −z. Пол платформы — на высоте 1,1.
// Станция конечная: платформа 250 м (от z = 6 до −244), за ней пути и сеть уходят к горизонту.
// Справочник объектов и компонентов — docs/objects.md, как собрать сцену — docs/scenes.md.
{
  "name": "Типовая платформа",
  "environment": {
    "azimuth": 250,                                   // куда по компасу смотрит ось −z (солнце, тени)
    "weather": "partly",                              // погода по умолчанию (если пользователь не выбрал)
    "shadows": { "x": [-18, 18], "y": [-1, 14], "z": [14, -110] }
  },
  "objects": [
    // ---------- камеры (ракурсы) ----------
    { "name": "Основной", "position": [0, 2.75, 0],
      "components": [{ "type": "Camera", "main": true, "label": "Основной", "focal": [0.6, 1.02], "center": [0.41, 0.44],
                       "portrait": { "focal": [0.74, 0], "center": [0.52, 0.5] } },
                     { "type": "CameraParallax" }] },
    { "name": "Общий", "position": [-1.6, 3.5, 6],
      "components": [{ "type": "Camera", "label": "Общий", "target": [3.2, 2.2, -60], "focal": [0.5, 0.85], "center": [0.45, 0.46] },
                     { "type": "CameraParallax" }] },
    { "name": "У края", "position": [0.9, 2.7, 2],
      "components": [{ "type": "Camera", "label": "У края", "target": [2.9, 2.3, -50], "focal": [0.56, 0.98], "center": [0.45, 0.45] },
                     { "type": "CameraParallax" }] },

    // ---------- дальний план ----------
    { "name": "Земля", "position": [0, -0.32, 0], "components": [{ "type": "Model", "model": "environment/ground", "castShadow": false }] },
    { "name": "Город", "components": [{ "type": "Model", "model": "environment/skyline", "params": { "seed": 7 }, "castShadow": false }] },
    { "name": "Деревья слева", "position": [-15, -0.32, -30],
      "repeat": { "count": 74, "step": [0, 0, -9], "jitter": [2.5, 0, 2], "scaleJitter": 0.25, "seed": 17 },
      "components": [{ "type": "Model", "model": "environment/tree", "params": { "color": "tree1" } }] },
    { "name": "Деревья справа", "position": [18, -0.32, -25],
      "repeat": { "count": 61, "step": [0, 0, -11], "jitter": [2.5, 0, 2], "scaleJitter": 0.25, "seed": 29 },
      "components": [{ "type": "Model", "model": "environment/tree", "params": { "color": "tree3", "seed": 2 } }] },
    { "name": "Пешеходный мост", "position": [3, 0, -165], "components": [{ "type": "Model", "model": "station/footbridge", "params": { "piers": [-12, 12] } }] },

    // ---------- пути и контактная сеть (уходят к горизонту) ----------
    { "name": "Путь 1", "position": [4.42, 0, 0],
      "components": [{ "type": "Model", "model": "station/track" }, { "type": "RailTrack", "platform": { "top": 1.1, "edge": 2.5 } }] },
    { "name": "Путь 2", "position": [9.7, 0, 0],
      "components": [{ "type": "Model", "model": "station/track" }, { "type": "RailTrack" }] },
    { "name": "Контактная сеть", "position": [7.06, 0, -30],
      "components": [{ "type": "Model", "model": "station/catenary", "params": { "tracks": [-2.64, 2.64], "count": 18 } }] },
    { "name": "Портал", "position": [3.8, 0, -62], "components": [{ "type": "Model", "model": "station/gantry", "params": { "width": 18.4 } }] },

    // ---------- платформа (конечной длины) ----------
    { "name": "Платформа", "position": [-0.85, 0, 6],
      "components": [{ "type": "Model", "model": "station/platform", "params": { "length": 250, "width": 6.7, "edges": ["+x"] }, "castShadow": false }] },
    { "name": "Ограда", "prefab": "fence", "position": [-4.2, 1.1, 4] },
    { "name": "Фонарь у входа", "prefab": "lamp", "position": [-3.56, 1.1, 6] },
    { "name": "Фонарь", "prefab": "lamp", "position": [-3.56, 1.1, -14], "repeat": { "count": 10, "step": [0, 0, -24] } },
    { "name": "Табло", "prefab": "departure-board", "position": [-1.8, 1.1, -6.3] },
    { "name": "Скамейка", "prefab": "bench", "position": [-3.55, 1.1, -20], "rotation": [0, 90, 0], "repeat": { "count": 5, "step": [0, 0, -24] } },

    // ---------- движение поездов ----------
    { "name": "Движение", "components": [
      { "type": "TrainTraffic", "role": "board", "track": "Путь 1",
        // приходит электровозом вперёд из-за горизонта, проходит мимо и встаёт хвостом в 7,2 м от камеры
        "arrival": { "heading": 1, "stop": { "far": -7.2 }, "from": 260, "ms": 21000 },
        // уходит хвостом мимо камеры
        "departure": { "heading": 1, "stop": { "far": -7.2 }, "ms": 9000 } }
      // транзитный грузовой по второму пути раз в 4–12 минут — раскомментируйте:
      // , { "type": "TrainTraffic", "role": "passing", "track": "Путь 2", "train": "freight", "heading": -1, "speed": 20, "every": [240, 720], "first": 30 }
    ] }
  ]
}
