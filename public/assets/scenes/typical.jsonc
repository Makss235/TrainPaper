// «Типовая платформа» — сцена по умолчанию для станций без своей сцены.
// Стоим на платформе и смотрим вдоль пути: справа — хвост поезда, путь уходит к горизонту,
// контактная сеть, ограда, фонари, деревья, город у горизонта; над платформой — табло.
//
// Координаты — метры: x — поперёк пути (вправо), y — вверх от головки рельса, z — вдоль пути;
// камера у z = 0 смотрит в сторону −z. Пол платформы — на высоте 1,1.
// Платформа короткая, 100 м (от z = 6 до −94): её конец виден — пандус на торце и пешеходный мост сразу за ним;
// дальше к горизонту уходят только пути и контактная сеть.
// Справочник объектов и компонентов — docs/objects.md, как собрать сцену — docs/scenes.md.
{
  "name": "Типовая платформа",
  "environment": {
    "azimuth": 250,                                   // куда по компасу смотрит ось −z (солнце, тени)
    "weather": "partly",                              // погода по умолчанию (если пользователь не выбрал)
    "planes": true,                                   // изредка высоко пролетает самолёт со шлейфом
    "shadows": { "x": [-18, 18], "y": [-1, 14], "z": [14, -110] }
  },
  "objects": [
    // ---------- камеры (ракурсы) ----------
    { "name": "Основной", "position": [0, 2.75, 0],
      "components": [{ "type": "Camera", "main": true, "label": "Основной", "focal": [0.6, 1.02], "center": [0.41, 0.44],
                       "portrait": { "focal": [0.74, 0], "center": [0.52, 0.5] } },
                     { "type": "CameraParallax" }] },
    { "name": "Общий", "position": [-1.6, 3.5, 6],
      "components": [{ "type": "Camera", "label": "Общий", "target": [3.2, 2.2, -60], "focal": [0.5, 0.85], "center": [0.45, 0.46] },
                     { "type": "CameraParallax" }] },
    { "name": "У края", "position": [0.9, 2.7, 2],
      "components": [{ "type": "Camera", "label": "У края", "target": [2.9, 2.3, -50], "focal": [0.56, 0.98], "center": [0.45, 0.45] },
                     { "type": "CameraParallax" }] },

    // ---------- дальний план ----------
    { "name": "Земля", "position": [0, -0.32, 0], "components": [{ "type": "Model", "model": "environment/ground", "castShadow": false }] },
    { "name": "Город", "components": [{ "type": "Model", "model": "environment/skyline", "params": { "seed": 7 }, "castShadow": false }] },
    // панорама города на заднике (картинка, ночью — огни окон) — раскомментируйте:
    // { "name": "Панорама", "components": [{ "type": "Backdrop", "texture": "img/backdrops/city.png", "nightTexture": "img/backdrops/city-night.png", "distance": 2200, "height": 150, "from": -75, "to": 75 }] },
    { "name": "Деревья слева", "position": [-15, -0.32, -30],
      "repeat": { "count": 74, "step": [0, 0, -9], "jitter": [2.5, 0, 2], "scaleJitter": 0.25, "seed": 17 },
      "components": [{ "type": "Model", "model": "environment/tree", "params": { "color": "tree1" } }] },
    { "name": "Деревья справа", "position": [18, -0.32, -25],
      "repeat": { "count": 61, "step": [0, 0, -11], "jitter": [2.5, 0, 2], "scaleJitter": 0.25, "seed": 29 },
      "components": [{ "type": "Model", "model": "environment/tree", "params": { "color": "tree3", "seed": 2 } }] },
    { "name": "Пешеходный мост", "position": [3, 0, -102], "components": [{ "type": "Model", "model": "station/footbridge", "params": { "piers": [-12, 12] } }] },

    // ---------- пути и контактная сеть (уходят к горизонту) ----------
    // ось пути — от z = 300 (за спиной камеры) к горизонту; поезда видны на участке visible (s, м от начала оси)
    { "name": "Путь 1", "position": [4.42, 0, 0],
      "components": [{ "type": "Model", "model": "station/track" }, { "type": "Track", "points": [[0, 0, 300], [0, 0, -3000]], "visible": [260, 1300] }] },
    { "name": "Путь 2", "position": [9.7, 0, 0],
      "components": [{ "type": "Model", "model": "station/track" }, { "type": "Track", "points": [[0, 0, 300], [0, 0, -3000]], "visible": [200, 1400] }] },
    // поезд с табло встаёт хвостом в 7,2 м от камеры; платформа слева от пути (если смотреть к горизонту)
    { "name": "Платформа 1", "position": [4.42, 0, -7.2],
      "components": [{ "type": "StopPoint", "track": "Путь 1", "align": "tail", "platform": { "top": 1.1, "edge": 1.92, "side": "left" } }] },
    { "name": "Контактная сеть", "position": [7.06, 0, -30],
      "components": [{ "type": "Model", "model": "station/catenary", "params": { "tracks": [-2.64, 2.64], "count": 18 } }] },
    { "name": "Портал", "position": [3.8, 0, -62], "components": [{ "type": "Model", "model": "station/gantry", "params": { "width": 18.4 } }] },

    // ---------- платформа (конечной длины) ----------
    { "name": "Платформа", "position": [-0.85, 0, 6],
      "components": [{ "type": "Model", "model": "station/platform", "params": { "length": 100, "width": 6.7, "edges": ["+x"] }, "castShadow": false }] },
    { "name": "Ограда", "prefab": "fence", "position": [-4.2, 1.1, 4],
      "components": [{ "type": "Model", "params": { "length": 98 } }, { "type": "StripeShadow", "length": 98 }] },
    { "name": "Фонарь у входа", "prefab": "lamp", "position": [-3.56, 1.1, 6] },
    { "name": "Фонарь", "prefab": "lamp", "position": [-3.56, 1.1, -14], "repeat": { "count": 4, "step": [0, 0, -24] } },
    { "name": "Табло", "prefab": "departure-board", "position": [-1.8, 1.1, -6.3] },
    { "name": "Скамейка", "prefab": "bench", "position": [-3.55, 1.1, -20], "rotation": [0, 90, 0], "repeat": { "count": 3, "step": [0, 0, -24] } },

    // ---------- движение поездов (rail/: менеджер, расписание, табло РЖД как источник) ----------
    { "name": "Движение", "components": [
      { "type": "TrainManager", "pause": 1.8 },
      { "type": "Schedule" },
      // поезд с табло: приходит электровозом вперёд из-за горизонта (к уменьшению s), встаёт у «Платформы 1»,
      // уходит дальше — мимо камеры
      { "type": "RzdBoard", "track": "Путь 1", "motion": { "brake": 1.2, "accel": 0.6 },
        "arrival": { "stop": "Платформа 1", "direction": -1, "approach": 420 },
        "departure": { "stop": "Платформа 1", "direction": -1, "approach": 420 } },
      // транзитный грузовой по соседнему пути раз в 4–12 минут (скрипт assets/scripts/rail/random-traffic.js);
      // не нужен — удалите эту строку
      { "type": "rail/random-traffic", "consists": ["freight"], "tracks": ["Путь 2"], "direction": 1, "every": [240, 720], "speed": [15, 25], "first": 30 }
    ] }
  ]
}
