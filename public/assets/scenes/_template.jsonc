// ШАБЛОН НОВОЙ СЦЕНЫ. Скопируйте файл (например, в tver.jsonc), поменяйте name, расставьте объекты
// и подключите сцену в index.jsonc:
//   "scenes": [ …, { "id": "tver", "name": "Тверь", "file": "tver.jsonc" } ],
//   "stations": { "1146": "tver" }             // ID станции РЖД → id сцены
// Проверить без смены станции: /platform/?scene=tver ; собрать ракурс и расставить объекты: ?scene=tver&dev=1
//
// Координаты — метры: x — поперёк пути (вправо), y — вверх от головки рельса, z — вдоль пути;
// камера у z = 0 смотрит в сторону −z. Пол платформы обычно на y = 1,1. Повороты — градусы.
// Объект = имя + положение + компоненты (docs/objects.md). Модели — assets/models/, префабы — assets/prefabs/.
{
  "name": "Новая станция",
  "environment": {
    "azimuth": 250,                                   // куда по компасу смотрит ось −z — от этого солнце и тени
    "weather": "partly",
    "shadows": { "x": [-18, 18], "y": [-1, 14], "z": [14, -110] }   // где считать тени (меньше — чётче)
  },
  "objects": [
    // камера: глаза на платформе (1,65 м над полом), смотрит вдоль пути
    { "name": "Основной", "position": [0, 2.75, 0],
      "components": [{ "type": "Camera", "main": true, "focal": [0.6, 1.02], "center": [0.41, 0.44] }, { "type": "CameraParallax" }] },

    { "name": "Земля", "position": [0, -0.32, 0], "components": [{ "type": "Model", "model": "environment/ground", "castShadow": false }] },

    // путь у платформы: вид (модель) + логика (RailTrack — сюда встают поезда)
    { "name": "Путь 1", "position": [4.42, 0, 0],
      "components": [{ "type": "Model", "model": "station/track" }, { "type": "RailTrack", "platform": { "top": 1.1, "edge": 2.5 } }] },
    { "name": "Контактная сеть", "position": [7.06, 0, -30],
      "components": [{ "type": "Model", "model": "station/catenary", "params": { "tracks": [-2.64], "count": 14 } }] },

    // платформа 200 м от z = 6
    { "name": "Платформа", "position": [-0.85, 0, 6],
      "components": [{ "type": "Model", "model": "station/platform", "params": { "length": 200, "width": 6.7 }, "castShadow": false }] },
    { "name": "Фонарь", "prefab": "lamp", "position": [-3.56, 1.1, -14], "repeat": { "count": 8, "step": [0, 0, -24] } },
    { "name": "Табло", "prefab": "departure-board", "position": [-1.8, 1.1, -6.3] },

    // заготовка здания (потом — модель из Blender: { "type": "Model", "model": "tver/station.glb" })
    // { "name": "Вокзал", "position": [-25, -0.32, -10], "components": [{ "type": "Model", "model": "station/building", "params": { "size": [30, 12, 60] } }] },
    // простая коробка:
    // { "name": "Киоск", "position": [-3, 1.1, -30], "components": [{ "type": "Primitive", "size": [2, 2.5, 3], "pivot": "bottom", "color": "wall" }] },

    { "name": "Движение", "components": [
      { "type": "TrainTraffic", "role": "board", "track": "Путь 1",
        "arrival": { "heading": 1, "stop": { "far": -7.2 } }, "departure": { "heading": 1, "stop": { "far": -7.2 } } }
    ] }
  ]
}
