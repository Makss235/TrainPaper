    "fence": "#2b2e32",
    "lamp": "#4b4f54",
    "ballast": "#8a8378",
    "sleeper": "#8e8a82",
    "rail": "#7d8287",
    "railhi": "#c3c7cb",
    "ground": "#86926f",
    "mast": "#8d9196",
    "wire": "#33373c",
    "trees": "#4f6b58",
    "trees2": "#6d8a75",
    "city": "#9aa6b3",
    "city2": "#adb7c2",
    "farplat": "#a9aaa5",
    "farroof": "#7c8590",
    "ground2": "#7c8a68",
    "city3": "#8f9ba8",
    "hills": "#7d8b86",
    "hills2": "#8f9c97",
    "trunk": "#5b4636",
    "tree1": "#4f7a4a",
    "tree2": "#5d8650",
    "tree3": "#557c58",
    "tree4": "#678f55",
    "tree5": "#4a6f4f",
    "tileLine": "#a7a8a2",
    "platformSide": "#9fa09b",
    "railTop": "#c6cace",
    "concrete": "#a9aaa6",
    "concreteDark": "#8e8f8b",
    "steel": "#7f858c",
    "insulator": "#5c3d2e",
    "mastBand": "#b04a3e",
