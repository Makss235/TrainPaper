  "aliases": {
    // ---- детальные модели (examples/) — раскомментируйте, чтобы включить ----
    "trains/coach-fpk": "examples/trains/coach-fpk.js",
    "trains/coach-double": "examples/trains/coach-double.js",
    "trains/loco-ep": "examples/trains/loco-ep.js",
    "trains/loco-freight": "examples/trains/loco-freight.js",
    "trains/emu-head": "examples/trains/emu-head.js",
