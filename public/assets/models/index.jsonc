// Манифест моделей. Движок читает его перед загрузкой сцены.
//
// palette  — имена цветов: в моделях и сценах можно писать "platform" вместо "#c4c4bf".
// aliases  — замены: имя модели → файл. Так включается другая модель без правки сцен.
//            Детальные модели лежат в examples/ — раскомментируйте строку, чтобы включить:
//            вместо примитива встанет модель с ливреей, окнами, контактной сетью по чертежу.
// models   — данные для моделей glTF (у них нет JS-описания): meta для логики (длина вагона и т. п.).
//
// Модель по имени ищется: aliases → файл <имя>.js в этой папке. Имя с .glb/.gltf — модель из Blender.
{
  "palette": {
    "body": "#d0d1d1",
    "band2": "#c3c5c9",
    "band": "#696b6d",
    "rib": "#58595c",
    "ribhi": "#7d7f81",
    "gutter": "#8e9297",
    "corr": "#b9bbbd",
    "pin": "#9b2b31",
    "darkend": "#61666a",
    "darkdoor": "#575b5f",
    "white": "#f4f4f4",
    "print": "#55585c",
    "red": "#e21a1a",
    "doorline": "#3a2a2b",
    "roof": "#4c4f53",
    "roofhi": "#cdd0d3",
    "roofbox": "#5f6266",
    "grille": "#5b5f65",
    "slat": "#8b8f94",
    "pillar": "#74777a",
    "handle": "#dcdddf",
    "slot": "#41454a",
    "lampbox": "#2e3135",
    "green": "#2f9e57",
    "redlamp": "#b8161c",
    "taillens": "#ff3524",
    "bellows": "#5d6166",
    "fold": "#45494e",
    "under": "#2b2d30",
    "step": "#5a5e63",
    "box": "#3a3d41",
    "frame": "#33363a",
    "text": "#ffffff",
